# ============================================================
#  SchoolRunner — Environment Variables
# ============================================================
#  Local development: copy this file to .env.local and fill in values.
#  Vercel: add each variable under Project Settings → Environment
#          Variables (Production, Preview, Development).
#
#  VARIABLE SCOPE:
#    VITE_*  → exposed to the browser at build time (Vite). Safe for
#              public keys only (Supabase URL, anon key).
#    (no prefix) → server-side ONLY. Never shipped to the browser.
#              Set these in Vercel, never in .env.local committed to git.
# ============================================================

# ------------------------------------------------------------------
#  CLIENT-SIDE (Vite) — exposed to browser. Prefix with VITE_.
# ------------------------------------------------------------------

#--- Supabase (public, same project used by the app) --------------
# Get these from Supabase → Settings → API.
# VITE_SUPABASE_URL = your Supabase project URL
# VITE_SUPABASE_ANON_KEY = your Supabase anon/public key (safe to expose)
VITE_SUPABASE_URL=https://rfsfkxplafwlmwncwduz.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_oTm73h3dofWHpDOHJWwCAw_2zXFiCxa

# Public base URL used for receipt QR verification links.
# Leave empty to use the current site origin.
VITE_RECEIPT_VERIFY_BASE_URL=

# ------------------------------------------------------------------
#  SERVER-SIDE (Vercel only) — NEVER prefix with VITE_.
#  Set these in the Vercel dashboard, not in .env.local.
# ------------------------------------------------------------------

#--- Nalo Solutions SMS Gateway (used by /api/send-sms) -----------
# API docs: Nalo "SMS API DOCUMENTATION" (Postman collection).
# NALO_SMS_AUTH_KEY = your Nalo auth key (preferred authentication)
# NALO_SMS_SENDER_ID = your APPROVED sender ID on the Nalo account
#                     (otherwise the gateway replies 1707 "Invalid Source")
NALO_SMS_AUTH_KEY=lhVsNZcrKSCu1UE7vgPuc0hIajAIb_MNu9UkNUT9trnJZ2N6TI8rBoE_olZp0uhB
NALO_SMS_SENDER_ID=SchoolRunner

# Alternative auth: authenticate with account username/password instead of auth key.
# NALO_SMS_USERNAME=your-nalo-username
# NALO_SMS_PASSWORD=your-nalo-password



