# ============================================================
#  SchoolRunner — Environment Variables
#  Copy to .env.local for local development.
#  Vercel: Dashboard -> Project -> Settings -> Environment Variables
#  Public VITE_* variables are inlined at build time and are safe
#  to expose (they are the Supabase publishable keys).
# ============================================================

#--- Supabase (same project used by the original app) ----------
VITE_SUPABASE_URL=https://rfsfkxplafwlmwncwduz.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_oTm73h3dofWHpDOHJWwCAw_2zXFiCxa

# Public base URL used for receipt QR verification links.
# Leave empty to use the current site origin.
VITE_RECEIPT_VERIFY_BASE_URL=

#--- Nalo Solutions SMS Gateway (server-side only) -------------
# Used by /api/send-sms (Vercel serverless function). NEVER prefix these
# with VITE_ — set them as Vercel project env vars, not in the browser.
# API docs: Nalo "SMS API DOCUMENTATION" (Postman 0a17d3ce-...).
# NALO_SMS_AUTH_KEY = Nalo auth "key" from your Nalo account.
# NALO_SMS_SENDER_ID must be an APPROVED sender id on the Nalo account,
# otherwise the gateway replies 1707 "Invalid Source(Sender)".
NALO_SMS_AUTH_KEY=lhVsNZcrKSCu1UE7vgPuc0hIajAIb_MNu9UkNUT9trnJZ2N6TI8rBoE_olZp0uhB
NALO_SMS_SENDER_ID=SchRunner
# Alternative auth: uncomment to authenticate with the account pair instead.
# NALO_SMS_USERNAME=
# NALO_SMS_PASSWORD=

