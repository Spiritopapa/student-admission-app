# ============================================================
#  SchoolRunner — Environment Variables
#  Copy to .env.local for local development.
#  Vercel: Dashboard -> Project -> Settings -> Environment Variables
#  Public VITE_* variables are inlined at build time and are safe
#  to expose (they are the Supabase publishable keys).
# ============================================================

#--- Supabase (same project used by the original app) ----------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Public base URL used for receipt QR verification links.
# Leave empty to use the current site origin.
VITE_RECEIPT_VERIFY_BASE_URL=

#--- Nalo Solutions SMS Gateway (server-side only) -------------
# Used by /api/send-sms. NEVER prefix these with VITE_.
NALO_SMS_AUTH_KEY=
NALO_SMS_SENDER_ID=
# NALO_SMS_USERNAME=
# NALO_SMS_PASSWORD=

#--- Supabase Service Role (server-side only) -----------------
# Used ONLY by /api/storage-delete to remove files from storage
# buckets on behalf of authorized users (RLS-safe server task).
# Set this in Vercel; never in the browser.
SUPABASE_SERVICE_ROLE_KEY=